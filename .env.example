# ==== Скопируйте этот файл в .env и заполните значения ====
# cp .env.example .env

# Порт локального сервера
PORT=3000

# Секрет для подписи cookie сессии.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Данные OAuth-приложения из GitHub:
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Адрес, который нужно указать в OAuth App как "Authorization callback URL"
# (должен совпадать символ в символ, иначе GitHub вернёт redirect_uri_mismatch)
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Где хранить прогресс (JSON-файл). Папка создастся автоматически.
DATA_FILE=./data/db.json

# development | production
NODE_ENV=development

# --- Для деплоя в интернет ---
# Внешний адрес приложения: из него собирается callback для GitHub.
# На Render он подставляется автоматически (RENDER_EXTERNAL_URL), на других хостингах задайте вручную.
# PUBLIC_URL=https://ваш-сервис.onrender.com
#
# Если у хостинга нет HTTPS, можно разрешить небезопасную cookie (в продакшене
# по умолчанию cookie отдаётся только по HTTPS):
# SESSION_COOKIE_SECURE=false

# --- Необязательные переопределения (нужны только для тестов или GitHub Enterprise) ---
# GITHUB_OAUTH_BASE_URL=https://github.com/login/oauth
# GITHUB_API_BASE_URL=https://api.github.com
